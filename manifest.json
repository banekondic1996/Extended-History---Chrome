{
  "manifest_version": 3,
  "name": "Extended History",
  "version": "4.2.1",
  "default_locale": "en",
  "description": "Unlimited history retention, session management, time tracking, bookmarks, multi-device.",
  "permissions": [
    "activeTab",
    "alarms",
    "bookmarks",
    "browsingData",
    "contextMenus",
    "history",
    "offscreen",
    "sessions",
    "sidePanel",
    "storage",
    "tabs",
    "unlimitedStorage",
    "webNavigation",
    "windows"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "externally_connectable": {
    "ids": [
      "kgoinbofcdfokmfmlgadadfkabjliofl"
    ],
    "matches": []
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "chrome_url_overrides": {
    "history": "html/history.html"
  },
  "omnibox": {
    "keyword": "q"
  },
  "side_panel": {
    "default_path": "html/popup.html?sidebar=1"
  },
  "commands": {
    "open_sidebar": {
      "suggested_key": {
        "default": "Ctrl+Shift+H"
      },
      "description": "Open Extended History in the sidebar"
    }
  },
  "action": {
    "default_popup": "html/popup.html",
    "default_title": "Extended History"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "116",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
