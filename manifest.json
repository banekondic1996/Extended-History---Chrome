{
  "manifest_version": 3,
  "name": "Extended History | Unlimited days of history",
  "version": "4.1.5",
  "default_locale": "en",
  "description": "Unlimited history retention, session management, time tracking, bookmarks, multi-device.",
  "permissions": [
    "activeTab",
    "alarms",
    "bookmarks",
    "browsingData",
    "contextMenus",
    "history",
    "sessions",
    "sidePanel",
    "storage",
    "tabs",
    "unlimitedStorage",
    "webNavigation",
    "windows"
  ],
  "externally_connectable": {
    "ids": ["kgoinbofcdfokmfmlgadadfkabjliofl"],
    "matches": []
  },
  "background": {
    "service_worker": "background.js"
  },
  "chrome_url_overrides": {
    "history": "history.html"
  },
  "side_panel": {
    "default_path": "popup.html?sidebar=1"
  },
  "commands": {
    "open_sidebar": {
      "suggested_key": {
        "default": "Ctrl+Shift+H"
      },
      "description": "Open Extended History in the sidebar"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Extended History"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}